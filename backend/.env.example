# IncidentIQ Backend Environment Variables Example
PORT=8080
JWT_SECRET=replace_with_your_jwt_secret
GEMINI_API_KEY=replace_with_your_gemini_api_key

# MySQL 8.0 Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=incidentiq_db
MYSQL_USER=incidentiq_user
MYSQL_PASSWORD=replace_with_your_mysql_password
